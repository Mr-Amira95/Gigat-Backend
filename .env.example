APP_NAME="Gigat Platform"
APP_ENV=production
APP_KEY=
# SECURITY [SEC-07]: Always false in production — exposing stack traces leaks DB credentials and env vars
APP_DEBUG=false
APP_TIMEZONE=Asia/Amman
APP_URL=https://dashboard.gigat.app
FRONTEND_URL=https://gigat.app

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# SECURITY [SEC-07]: Use 'error' in production — 'debug' logs sensitive data
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=swift_gigat
DB_USERNAME=root
# SECURITY [SEC-18]: Must be a strong randomly-generated password — never empty in production
DB_PASSWORD=

# mini DB
MINI_DB_HOST=127.0.0.1
MINI_DB_PORT=3306
MINI_DB_DATABASE=
MINI_DB_USERNAME=
MINI_DB_PASSWORD=

CACHE_DRIVER=database

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=pusher
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mail.gigat.app
MAIL_PORT=465
MAIL_USERNAME=support@gigat.app
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=support@gigat.app
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# SECURITY [SEC-08]: Must be false in production — /telescope exposes all requests, SQL queries, and secrets publicly
TELESCOPE_ENABLED=false

PASSPORT_PERSONAL_ACCESS_CLIENT_ID=
PASSPORT_PERSONAL_ACCESS_CLIENT_SECRET=

ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=
ONESIGNAL_USER_AUTH_KEY=

AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Google Cloud Translation
GOOGLE_APPLICATION_CREDENTIALS=storage/app/private/google-translate.json
GOOGLE_PROJECT_ID=

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=

# SECURITY [SEC-13/SEC-14]: Use LIVE keys in production. Rotate all keys — test keys are compromised if .env was ever committed.
# Comment out whichever mode is not active.
# --- TEST MODE ---
STRIPE_KEY=pk_test_
STRIPE_SECRET=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_

# --- LIVE MODE (uncomment for production) ---
# STRIPE_KEY=pk_live_
# STRIPE_SECRET=sk_live_
# STRIPE_WEBHOOK_SECRET=whsec_

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME="https"
PUSHER_APP_CLUSTER="mt1"

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# whatsapp otp
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WA_TEMPLATE_NAME=otp_template

# Bot / AI
EXTERNAL_FAQ_URL=
EXTERNAL_SERVICE_URL=
EXTERNAL_API_TOKEN=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
